{
  "main": "lib/index.js",
  "scripts": {
    "lint": "node lint.cjs",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx -y firebase-tools@latest emulators:start --only functions",
    "shell": "npm run build && npx -y firebase-tools@latest functions:shell",
    "start": "npm run shell",
    "deploy": "npx -y firebase-tools@latest deploy --only functions",
    "logs": "npx -y firebase-tools@latest functions:log"
  },
  "name": "functions",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
