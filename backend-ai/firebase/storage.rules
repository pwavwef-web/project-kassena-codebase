rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function hasProfile() {
      return isSignedIn() && firestore.exists(userPath(request.auth.uid));
    }

    function role() {
      return hasProfile() ? firestore.get(userPath(request.auth.uid)).data.role : 'user';
    }

    function hasAnyRole(roles) {
      return isSignedIn() && role() in roles;
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('text/plain')
        || request.resource.contentType.matches('application/pdf');
    }

    function withinFileLimit() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    function canReadTier(tier, ownerId) {
      return (
        tier == 'OPEN'
        && isSignedIn()
      )
      || (
        tier == 'RESTRICTED'
        && (
          request.auth.uid == ownerId
          || hasAnyRole(['validator', 'elder', 'cultural custodian', 'community manager', 'administrator'])
        )
      )
      || (
        tier == 'SENSITIVE'
        && hasAnyRole(['elder', 'cultural custodian', 'community manager', 'administrator'])
      );
    }

    match /media/{tier}/{community}/{ownerId}/{fileName} {
      allow read: if canReadTier(tier, ownerId);
      allow write: if isSignedIn()
        && request.auth.uid == ownerId
        && tier in ['OPEN', 'RESTRICTED', 'SENSITIVE']
        && withinFileLimit()
        && isAllowedType();
    }

    match /contributions/{ownerId}/{contributionId}/{fileName} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == ownerId
          || hasAnyRole(['validator', 'community manager', 'administrator'])
        );
      allow write: if isSignedIn()
        && request.auth.uid == ownerId
        && withinFileLimit()
        && isAllowedType();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
